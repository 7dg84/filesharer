# Puerto del servidor backend
PORT=3000

# Credenciales de usuario administrador por defecto (se sembrará en la base de datos al arrancar si no hay usuarios)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123

# Secreto para firmar los tokens JWT
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Configuración de base de datos
SQLITE_DB_PATH=./data/database.sqlite

# Configuración de MinIO (Almacenamiento de Objetos)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword123
MINIO_BUCKET=filesharer-bucket

# Endpoints de MinIO:
# 1. URL interna para que el backend se conecte (usado en Docker)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false

# 2. Reemplazo para URL externa (usado por el cliente/navegador del usuario)
# Localmente: http://localhost:9000
# Producción: tu dominio público de MinIO o localhost expuesto
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000

# Token del túnel de Cloudflare (Zero Trust)
CLOUDFLARE_TUNNEL_TOKEN=tu_token_de_cloudflare_aqui
